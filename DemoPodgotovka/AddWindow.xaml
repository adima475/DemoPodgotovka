<Window x:Class="DemoPodgotovka.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoPodgotovka"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Окно добавления" Height="521" Width="500">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Название" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Вид" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="1"/>
                <TextBlock Text="Год" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="2"/>
                <TextBlock Text="Объём бака" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="3"/>
                <TextBlock Text="Вместимость" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="4"/>
                <TextBlock Text="Тип руля" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="5"/>
                <TextBlock Text="Цена за сутки" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="6"/>
                <TextBlock Text="Описание" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="7"/>
            </Grid>


            <Grid Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,40,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black">
                    <TextBox Name="Title" FontSize="15" FontWeight="Bold" Background="Transparent" VerticalAlignment="Center" BorderThickness="0"/>
                </Border>
                <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" Grid.Row="1">
                    <TextBox Name="Kind" FontSize="15" FontWeight="Bold" Background="Transparent" VerticalAlignment="Center" BorderThickness="0"/>
                </Border>
                <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" Grid.Row="2">
                    <TextBox Name="Yearauto" FontSize="15" FontWeight="Bold" Background="Transparent" VerticalAlignment="Center" BorderThickness="0"/>
                </Border>
                <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" Grid.Row="3">
                    <TextBox Name="Valuebenzin" FontSize="15" FontWeight="Bold" Background="Transparent" VerticalAlignment="Center" BorderThickness="0"/>
                </Border>
                <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" Grid.Row="4">
                    <TextBox Name="Vmestimost" FontSize="15" FontWeight="Bold" Background="Transparent" VerticalAlignment="Center" BorderThickness="0"/>
                </Border>
                <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" Grid.Row="5">
                    <TextBox Name="Ruletype" FontSize="15" FontWeight="Bold" Background="Transparent" VerticalAlignment="Center" BorderThickness="0"/>
                </Border>
                <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" Grid.Row="6">
                    <TextBox Name="Priceday" FontSize="15" FontWeight="Bold" Background="Transparent" VerticalAlignment="Center" BorderThickness="0"/>
                </Border>
                <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" Grid.Row="7">
                    <TextBox Name="Description" FontSize="15" FontWeight="Bold" Background="Transparent" VerticalAlignment="Center" BorderThickness="0"/>
                </Border>
            </Grid>

        </Grid>

        <Border Padding="5" Background="Blue" CornerRadius="5" Grid.Row="1" Width="100" HorizontalAlignment="Right" Margin="0,25,40,0" >
            <Button Content="Добавить" BorderThickness="0" Background="Transparent" Foreground="White" Height="25"/>
        </Border>

    </Grid>
</Window>
