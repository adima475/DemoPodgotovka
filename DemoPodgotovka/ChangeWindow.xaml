<Window x:Class="DemoPodgotovka.ChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoPodgotovka"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Окно изменения" Height="525" Width="399">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="20,0,20,0">
            <TextBlock Text="Название" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
            <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" HorizontalAlignment="Right">
                <TextBox Name="TitleTextBox" FontSize="15" FontWeight="Bold" Background="Transparent" BorderThickness="0"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="20,0,20,0">
            <TextBlock Text="Вид" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
            <ComboBox Name="TypeComboBox" FontSize="15" FontWeight="Bold" Background="Transparent" BorderThickness="0" Width="200" Height="30" HorizontalAlignment="Right"/>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="20,0,20,0">
            <TextBlock Text="Год" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
            <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" HorizontalAlignment="Right">
                <TextBox Name="YearTextBox" FontSize="15" FontWeight="Bold" Background="Transparent" BorderThickness="0"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="20,0,20,0">
            <TextBlock Text="Объем бака" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
            <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" HorizontalAlignment="Right">
                <TextBox Name="TankValueTextBox" FontSize="15" FontWeight="Bold" Background="Transparent" BorderThickness="0"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="4" Margin="20,0,20,0">
            <TextBlock Text="Вместимость" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
            <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" HorizontalAlignment="Right">
                <TextBox Name="PeoplesTextBox" FontSize="15" FontWeight="Bold" Background="Transparent" BorderThickness="0"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="5" Margin="20,0,20,0">
            <TextBlock Text="Тип руля" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
            <ComboBox Name="TypeRyleComboBox" FontSize="15" FontWeight="Bold" Background="Transparent" BorderThickness="0" Width="200" Height="30" HorizontalAlignment="Right">
                <ComboBoxItem Content="Левый"/>
                <ComboBoxItem Content="Правый" />
            </ComboBox>
        </DockPanel>

        <DockPanel Grid.Row="6" Margin="20,0,20,0">
            <TextBlock Text="Цена за сутки" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
            <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" HorizontalAlignment="Right">
                <TextBox Name="PriceTextBox" FontSize="15" FontWeight="Bold" Background="Transparent" BorderThickness="0"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="7" Margin="20,0,20,0">
            <TextBlock Text="Описание" Padding="15" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
            <Border Padding="5" Width="200" Height="30" CornerRadius="5" BorderThickness="0.5" BorderBrush="Black" HorizontalAlignment="Right">
                <TextBox Name="DescriptionTextBox" FontSize="15" FontWeight="Bold" Background="Transparent" BorderThickness="0"/>
            </Border>
        </DockPanel>

        <Border Padding="5" Background="Blue" CornerRadius="5" Grid.Row="9" Width="100" HorizontalAlignment="Right" Margin="0,10,20,15" >
            <Button Name="EditButton" Content="Изменить" BorderThickness="0" Background="Transparent" Foreground="White" Height="25" Click="editButton_Click" />
        </Border>
    </Grid>
</Window>
