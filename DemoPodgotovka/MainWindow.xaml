<Window x:Class="DemoPodgotovka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoPodgotovka"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="MainWindow" MinHeight="450" MinWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderThickness="0.5" BorderBrush="Black">
            
        <DockPanel>
            <TextBlock Text="MORENT" FontSize="24" Foreground="Blue" FontWeight="DemiBold" Margin="30,30,0,30"/>
            <Image Source="/Resource/Icons/Search.png" Height="40"/>
            <Image Source="/Resource/Icons/Menu.png" Height="50" HorizontalAlignment="Right"/>

        </DockPanel>
        </Border>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <StackPanel Margin="30">
                <Border Padding="15" CornerRadius="5" Background="Blue" Margin="0,0,0,15">
                    <Button Content="Добавить" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="15" FontWeight="Bold" Click="add_button_click"/>
                </Border>

                <Border Padding="15" CornerRadius="5" Background="Blue">
                    <Button Content="Изменить" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="15" FontWeight="Bold" Click="change_button_click" />
                </Border>
            </StackPanel>
            
        <ListBox ItemsSource="{Binding Cars}" Background="Gray" Grid.Column="1">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    
                    <Border MinWidth="250" MaxWidth="320" Height="320" Padding="10,15,15,10" Background="White" Margin="10" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Height="65">
                                <StackPanel Width="180">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Kind}" Foreground="SlateGray"/>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="40,0,0,20">
                                    <Button Name="Heart" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Click="Heart_Click">
                                        <Image Source="/Resource/Icons/heart.png" Width="20"/>
                                    </Button>
                                    <Button Name="RedHeart" BorderThickness="0" Background="Transparent" Visibility="Collapsed" Click="Heart_Click">
                                        <Image Source="/Resource/Icons/HeartRed.png" Width="20"/>
                                    </Button>

                                </StackPanel>

                            </DockPanel>

                            <!--Фотка машины-->
                            <Image Source="{Binding Url}" Width="180" Height="160" Grid.Row="1"/>

                            <Grid Margin="5,5,0,10" Grid.Row="2" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Левая колонка -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Image Source="/Resource/Icons/gas-station.png" Width="20" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Valuebenzin}" Foreground="SlateGray"/>
                                </StackPanel>

                                <!-- Центрированная колонка -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Source="/Resource/Icons/Car.png" Width="20" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Ruletype}" Foreground="SlateGray"/>
                                </StackPanel>

                                <!-- Правая колонка -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Image Source="/Resource/Icons/profile-2user.png" Width="20" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Vmestimost}" Margin="0,0,15,0" Foreground="SlateGray"/>
                                </StackPanel>
                            </Grid>


                            <DockPanel VerticalAlignment="Bottom" Grid.Row="3">
                                <TextBlock Text="{Binding Price}" FontSize="18" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="day" VerticalAlignment="Center" Foreground="SlateGray"/>
                                <Border CornerRadius="3" Padding="5" Background="Blue" Margin="25,0,10,0" Height="35" Width="90" HorizontalAlignment="Right">
                                    <Button BorderThickness="0" Background="Transparent" Content="Rent Now" Foreground="White"/>
                                </Border>

                            </DockPanel>
                        </Grid>
                    </Border>

                    </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
    </Grid>
</Window>
